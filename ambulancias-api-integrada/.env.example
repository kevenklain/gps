APP_NAME="Ambulancias API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Sao_Paulo
APP_LOCALE=pt_BR

LOG_CHANNEL=stderr
LOG_LEVEL=debug
CACHE_STORE=file

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=ambulancias
DB_USERNAME=ambulancias
DB_PASSWORD=ambulancias123

# Usuario admin criado automaticamente pelo seeder.
# TROQUE esta senha em um projeto real.
ADMIN_NOME=Administrador
ADMIN_EMAIL=admin@ambulancias.local
ADMIN_PASSWORD=admin123

# Login da interface pgAdmin, separado do usuario do PostgreSQL e da API.
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@ambulancias.com
PGADMIN_DEFAULT_PASSWORD=troque-esta-senha-local
